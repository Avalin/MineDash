@using Microsoft.AspNetCore.Components.Authorization

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="css/console.css" />
    <link rel="stylesheet" href="css/players-dialog.css" />
    <link rel="stylesheet" href="@Assets["MineDash.styles.css"]" />
    <link rel="stylesheet" href="css/help-panel.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.scrollToBottom = (elementId) => {
            const element = document.getElementById(elementId);
            if (!element) return;
            const scroll = () => { element.scrollTop = element.scrollHeight; };
            scroll();
            requestAnimationFrame(() => {
                scroll();
                requestAnimationFrame(scroll);
            });
        };

        window.isConsoleAtBottom = (elementId, threshold = 48) => {
            const element = document.getElementById(elementId);
            if (!element) return true;
            return element.scrollHeight - element.scrollTop - element.clientHeight <= threshold;
        };
        
        window.scrollToLastCommand = (elementId) => {
            const element = document.getElementById(elementId);
            if (element) {
                // Find the last console-entry (command) element
                const entries = element.querySelectorAll('.console-entry');
                if (entries.length > 0) {
                    const lastEntry = entries[entries.length - 1];
                    lastEntry.scrollIntoView({ behavior: 'smooth', block: 'end' });
                } else {
                    // Fallback to bottom if no commands found
                    element.scrollTop = element.scrollHeight;
                }
            }
        };
        
        window.navigateToHome = () => {
            window.location.replace('/');
        };
        
        window.getSelectedValues = (selectId) => {
            const select = document.getElementById(selectId);
            if (!select) return [];
            return Array.from(select.selectedOptions).map(option => parseInt(option.value));
        };
    </script>
</body>

</html>
