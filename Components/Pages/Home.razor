@page "/"
@rendermode InteractiveServer
@using MineDash.Models
@using MineDash.Services
@using MineDash.Components.Console
@using Microsoft.AspNetCore.Components
@inject IServerConfigStore ServerStore
@inject ICommandStore CommandStore
@inject IAuthService AuthService
@inject IConsoleSessionPersistence ConsolePersistence
@inject IConsoleLogFilterService LogFilters
@inject IConsoleLogRetentionService LogRetention
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>MineDash</PageTitle>

<div class="page-layout-container">
<div class="page-layout layout-cols-@EffectiveColumnCount" @onclick="CloseAllFilterDropdowns">
    <div class="command-panel">
        <div class="console-toolbar">
            @if (ShouldShowAddConsoleToolbar())
            {
                var canAdd = CanAddMoreConsoles();
                var availableToAdd = GetServersAvailableToAdd().ToList();
                <div class="toolbar-section add-console-section @(_addConsoleExpanded || !IsMobileViewport ? "expanded" : "")">
                    @if (IsMobileViewport)
                    {
                        <button type="button"
                                class="add-console-toggle"
                                aria-expanded="@_addConsoleExpanded"
                                @onclick="ToggleAddConsole">
                            <span class="bi @(_addConsoleExpanded ? "bi-chevron-down" : "bi-plus-lg")" aria-hidden="true"></span>
                            <span>Add console</span>
                        </button>
                    }

                    <div class="add-console-form">
                        @if (canAdd)
                        {
                            <div class="add-console-row">
                                <select class="form-select form-select-sm"
                                        @bind="_selectedAddServerId"
                                        aria-label="Server to add">
                                    @foreach (var s in availableToAdd)
                                    {
                                        <option value="@s.Id">
                                            @s.Name (@s.Host:@s.RconPort)
                                        </option>
                                    }
                                </select>

                                <button class="btn btn-sm btn-outline-light"
                                        @onclick="AddConsole"
                                        disabled="@string.IsNullOrEmpty(_selectedAddServerId)">
                                    Add console
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="add-console-hint">All servers are open.</p>
                        }
                    </div>
                </div>
            }
            else if (_servers is null || !_servers.Any())
            {
                <div class="toolbar-section add-console-section">
                    <div class="add-console-form">
                        <div class="add-console-row">
                            <select class="form-select form-select-sm" disabled>
                                <option>No servers registered</option>
                            </select>
                        </div>
                    </div>
                </div>
            }

            <div class="toolbar-section layout-section">
                <label class="server-select-label">Layout</label>
                <div class="btn-group btn-group-sm">
                    <button class="@GetLayoutButtonClass(1)" @onclick="@(() => SetLayout(1))" type="button">
                        <div class="layout-icon layout-icon-1">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </button>
                    <button class="@GetLayoutButtonClass(2)" @onclick="@(() => SetLayout(2))" type="button">
                        <div class="layout-icon layout-icon-2">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </button>
                    <button class="@GetLayoutButtonClass(3)" @onclick="@(() => SetLayout(3))" type="button">
                        <div class="layout-icon layout-icon-3">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        @if (_servers is null || !_servers.Any())
        {
            <p class="no-server-text">
                No servers configured. Go to <strong>Server Management</strong> to add one.
            </p>
        }
        else if (!_openConsoleIds.Any())
        {
            <p class="no-server-text">
                No consoles open. Use <strong>Add console</strong> to start monitoring a server.
            </p>
        }
        else
        {
            <div class="console-grid" style="@GridColumnStyle">
                @foreach (var serverId in _openConsoleIds)
                {
                    var server = _servers!.FirstOrDefault(s => s.Id == serverId);
                    if (server is null)
                    {
                        continue;
                    }

                    <div class="console-grid-item">
                        <ServerConsole Server="server"
                                       State="GetConsoleState(serverId)"
                                       Commands="@GetCommands()"
                                       DefaultSayCommandId="@_defaultSayCommandId"
                                       CloseFiltersTick="@_closeFiltersTick"
                                       OnClose="@(() => CloseConsole(serverId))"
                                       OnPlayersClick="@(() => OpenPlayersDialog(server))"
                                       OnPersistRequested="SavePersistedState" />
                    </div>
                }
            </div>
        }
    </div>

    <div class="help-panel">
        <h4>Minecraft Commands</h4>
        @if (_commands is null)
        {
            <p>Loading commands...</p>
        }
        else if (!_commands.Any())
        {
            <p class="no-command-text">No commands configured.</p>
        }
        else
        {
            <div class="help-list">
                @foreach (var cmd in MinecraftCommandSyntax.OrderForDisplay(_commands))
                {
                    <button type="button"
                            class="help-command-btn @(IsCommandSelectedInConsoles(cmd) ? "selected" : "")"
                            title="Use this command"
                            @onclick="@(() => SelectCommand(cmd))">
                        <span class="help-command-syntax">@cmd.Syntax</span>
                        @if (!string.IsNullOrWhiteSpace(cmd.Description))
                        {
                            <span class="help-command-desc">@cmd.Description</span>
                        }
                    </button>
                }
            </div>
        }
    </div>
</div>
</div>

@if (_playersDialogServer is not null)
{
    <PlayersListDialog Show="@_showPlayersDialog"
                       Server="_playersDialogServer"
                       LiveLogs="@GetConsoleState(_playersDialogServer.Id).LiveLogs"
                       OnClose="ClosePlayersDialog" />
}

@code {
    private List<ServerConfig>? _servers;
    private List<MinecraftCommand>? _commands;
    private string? _defaultSayCommandId;
    private readonly List<string> _openConsoleIds = new();
    private readonly Dictionary<string, ConsoleState> _consoleStates = new();
    private string? _selectedAddServerId;
    private int _layoutColumns = 1;
    private long _closeFiltersTick;
    private bool _addConsoleExpanded;
    private bool _isMobileViewport;
    private int _viewportDefaultLineLimit = LogHistoryPresets.DefaultLineLimit;
    private bool _viewportLineLimitResolved;
    private readonly HashSet<string> _consolesAwaitingLineLimit = new();
    private bool _showPlayersDialog;
    private ServerConfig? _playersDialogServer;

    private string GridColumnStyle =>
        $"grid-template-columns: repeat({EffectiveColumnCount}, minmax(0, 1fr));";

    private int EffectiveColumnCount
    {
        get
        {
            var count = _openConsoleIds.Count;
            if (count == 0)
                return 1;

            return _layoutColumns == 1 ? 1 : Math.Min(_layoutColumns, count);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _servers = (await ServerStore.GetAllAsync()).ToList();
        await LoadCommands();
        await LoadPersistedState();

        SyncSelectedAddServerId();

        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _viewportLineLimitResolved)
            return;

        var stateChanged = false;

        try
        {
            var width = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            _isMobileViewport = width < 768;
            _viewportDefaultLineLimit = LogHistoryPresets.GetDefaultLineLimitForViewport(width);
            stateChanged = await ApplyDefaultOpenConsolesAsync(width);
        }
        catch
        {
            _viewportDefaultLineLimit = LogHistoryPresets.DefaultLineLimit;
            if (_servers is { Count: > 0 } && !_openConsoleIds.Any())
            {
                _openConsoleIds.Add(_servers[0].Id);
                stateChanged = true;
            }
        }

        _viewportLineLimitResolved = true;

        foreach (var serverId in _consolesAwaitingLineLimit)
        {
            if (_consoleStates.TryGetValue(serverId, out var state))
                state.LogLineLimit = _viewportDefaultLineLimit;
        }

        _consolesAwaitingLineLimit.Clear();

        if (stateChanged)
        {
            SyncSelectedAddServerId();
            await SavePersistedState();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> ApplyDefaultOpenConsolesAsync(int viewportWidthPx)
    {
        if (_servers is null || !_servers.Any() || _openConsoleIds.Any())
            return false;

        if (viewportWidthPx < 768)
        {
            foreach (var server in _servers)
                _openConsoleIds.Add(server.Id);
        }
        else
        {
            _openConsoleIds.Add(_servers[0].Id);
        }

        return true;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        await SavePersistedState();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var location = new Uri(e.Location);
        var baseUri = new Uri(Navigation.BaseUri);
        var relativePath = baseUri.MakeRelativeUri(location).ToString();

        if (relativePath is "" or "/" or "index.html")
        {
            _ = InvokeAsync(async () =>
            {
                await LoadCommands();
                StateHasChanged();
            });
        }
    }

    private async Task LoadCommands()
    {
        _commands = (await CommandStore.GetAllAsync()).ToList();
        _defaultSayCommandId = _commands
            .FirstOrDefault(c => MinecraftCommandSyntax.GetCommandName(c).Equals("say", StringComparison.OrdinalIgnoreCase))?.Id
            ?? _commands.FirstOrDefault()?.Id;

        foreach (var state in _consoleStates.Values)
        {
            if (string.IsNullOrEmpty(state.SelectedCommandId))
                state.SelectedCommandId = _defaultSayCommandId ?? string.Empty;
        }
    }

    private ConsoleState GetConsoleState(string serverId)
    {
        if (!_consoleStates.TryGetValue(serverId, out var state))
        {
            state = new ConsoleState(serverId);
            if (!string.IsNullOrEmpty(_defaultSayCommandId))
                state.SelectedCommandId = _defaultSayCommandId;

            if (_viewportLineLimitResolved)
                state.LogLineLimit = _viewportDefaultLineLimit;
            else
                _consolesAwaitingLineLimit.Add(serverId);

            _consoleStates[serverId] = state;
        }

        return state;
    }

    private void ToggleAddConsole()
    {
        _addConsoleExpanded = !_addConsoleExpanded;
        SyncSelectedAddServerId();
        StateHasChanged();
    }

    private bool IsMobileViewport => _isMobileViewport;

    private bool ShouldShowAddConsoleToolbar() =>
        _servers is { Count: > 0 } && (_isMobileViewport || CanAddMoreConsoles());

    private IEnumerable<ServerConfig> GetServersAvailableToAdd() =>
        _servers?.Where(s => !_openConsoleIds.Contains(s.Id)) ?? Enumerable.Empty<ServerConfig>();

    private bool CanAddMoreConsoles() =>
        _servers is not null && _servers.Any() && GetServersAvailableToAdd().Any();

    private void SyncSelectedAddServerId()
    {
        var available = GetServersAvailableToAdd().ToList();
        if (available.Count == 0)
        {
            _selectedAddServerId = string.Empty;
            return;
        }

        if (available.Count == 1
            || string.IsNullOrEmpty(_selectedAddServerId)
            || available.All(s => s.Id != _selectedAddServerId))
        {
            _selectedAddServerId = available[0].Id;
        }
    }

    private async Task AddConsole()
    {
        if (string.IsNullOrWhiteSpace(_selectedAddServerId) || _openConsoleIds.Contains(_selectedAddServerId))
        {
            StateHasChanged();
            _selectedAddServerId = string.Empty;
            return;
        }

        var addedId = _selectedAddServerId;
        _openConsoleIds.Add(addedId);
        GetConsoleState(addedId).MobileExpanded = true;
        _addConsoleExpanded = IsMobileViewport;
        SyncSelectedAddServerId();
        await SavePersistedState();
        StateHasChanged();
    }

    private async Task CloseConsole(string serverId)
    {
        if (_playersDialogServer?.Id == serverId)
            ClosePlayersDialog();

        _openConsoleIds.Remove(serverId);
        SyncSelectedAddServerId();
        _addConsoleExpanded = true;
        await SavePersistedState();
        StateHasChanged();
    }

    private async Task SetLayout(int columns)
    {
        _layoutColumns = Math.Clamp(columns, 1, 3);
        await SavePersistedState();
        StateHasChanged();
    }

    private string GetLayoutButtonClass(int columns) =>
        "btn btn-sm " + (_layoutColumns == columns ? "btn-primary" : "btn-outline-light");

    private void SelectCommand(MinecraftCommand cmd)
    {
        foreach (var serverId in _openConsoleIds)
        {
            var state = GetConsoleState(serverId);
            state.SelectedCommandId = cmd.Id;
            state.CommandArguments = string.Empty;
        }

        StateHasChanged();
    }

    private bool IsCommandSelectedInConsoles(MinecraftCommand cmd) =>
        _openConsoleIds.Any() &&
        _openConsoleIds.All(id =>
            MinecraftCommandSyntax.ResolveSelectedCommandId(
                GetConsoleState(id), GetCommands(), _defaultSayCommandId) == cmd.Id);

    private IReadOnlyList<MinecraftCommand> GetCommands() =>
        _commands is null ? Array.Empty<MinecraftCommand>() : _commands;

    private void CloseAllFilterDropdowns()
    {
        _closeFiltersTick++;
        StateHasChanged();
    }

    private void OpenPlayersDialog(ServerConfig server)
    {
        _playersDialogServer = server;
        _showPlayersDialog = true;
        _closeFiltersTick++;
        StateHasChanged();
    }

    private void ClosePlayersDialog()
    {
        _showPlayersDialog = false;
        _playersDialogServer = null;
        StateHasChanged();
    }

    private async Task LoadPersistedState()
    {
        var persisted = await ConsolePersistence.LoadAsync();
        if (persisted is null)
            return;

        if (_servers is not null && persisted.OpenConsoleIds is not null)
        {
            _openConsoleIds.Clear();
            _openConsoleIds.AddRange(
                persisted.OpenConsoleIds.Where(id => _servers.Any(s => s.Id == id)));
        }

        if (persisted.LayoutColumns is >= 1 and <= 3)
            _layoutColumns = persisted.LayoutColumns;

        if (persisted.ConsoleStates is null)
            return;

        foreach (var (serverId, toggle) in persisted.ConsoleStates)
        {
            var state = GetConsoleState(serverId);
            state.ShowLogs = toggle.ShowLogs;
            state.ShowCommands = toggle.ShowCommands;
            state.LevelFilterActive = toggle.LevelFilterActive;
            state.ThreadFilterActive = toggle.ThreadFilterActive;

            if (toggle.SelectedLogLevels is not null)
                state.SelectedLogLevels = LogFilters.NormalizeLevelSelections(toggle.SelectedLogLevels);

            if (toggle.SelectedThreads is not null)
            {
                state.SelectedThreads = LogFilters.NormalizeThreadSelections(toggle.SelectedThreads);
                state.ThreadFilterInitialized = true;
            }
            else if (toggle.ThreadFilterActive)
            {
                state.ThreadFilterInitialized = true;
            }

            if (toggle.LogHistoryMinutes.HasValue)
                state.LogHistoryMinutes = toggle.LogHistoryMinutes.Value;
            else if (toggle.LogHistoryHours is > 0)
                state.LogHistoryMinutes = toggle.LogHistoryHours.Value * 60;

            if (toggle.LogLineLimit >= 0)
                state.LogLineLimit = toggle.LogLineLimit;

            state.AutoscrollMode = toggle.AutoscrollMode;
            state.MobileExpanded = toggle.MobileExpanded;
        }
    }

    private async Task SavePersistedState()
    {
        var consoleStates = _openConsoleIds.ToDictionary(
            serverId => serverId,
            serverId =>
            {
                var state = GetConsoleState(serverId);
                return new ConsoleToggleState
                {
                    ShowLogs = state.ShowLogs,
                    ShowCommands = state.ShowCommands,
                    LevelFilterActive = state.LevelFilterActive,
                    ThreadFilterActive = state.ThreadFilterActive,
                    SelectedLogLevels = state.SelectedLogLevels.ToList(),
                    SelectedThreads = state.SelectedThreads.ToList(),
                    LogHistoryMinutes = state.LogHistoryMinutes,
                    LogLineLimit = state.LogLineLimit,
                    AutoscrollMode = state.AutoscrollMode,
                    MobileExpanded = state.MobileExpanded
                };
            });

        await ConsolePersistence.SaveAsync(new HomeConsolePersistedState
        {
            OpenConsoleIds = _openConsoleIds.ToList(),
            LayoutColumns = _layoutColumns,
            ConsoleStates = consoleStates
        });
    }
}
