@page "/"
@rendermode InteractiveServer
@using MineDash.Models
@using MineDash.Services
@using MineDash.Components.Console
@using Microsoft.AspNetCore.Components
@inject IServerConfigStore ServerStore
@inject ICommandStore CommandStore
@inject IAuthService AuthService
@inject IConsoleSessionPersistence ConsolePersistence
@inject IConsoleLogFilterService LogFilters
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>MineDash</PageTitle>

<div class="page-layout" @onclick="CloseAllFilterDropdowns">
    <div class="command-panel">
        <div class="console-toolbar">
            <div class="toolbar-section">
                <label class="server-select-label">Add console</label>

                @if (_servers is null || !_servers.Any())
                {
                    <div class="add-console-row">
                        <select class="form-select form-select-sm" disabled>
                            <option>No servers registered</option>
                        </select>
                    </div>
                }
                else
                {
                    <div class="add-console-row">
                        <select class="form-select form-select-sm"
                                @bind="_selectedAddServerId">
                            <option value="">Select server…</option>
                            @foreach (var s in _servers)
                            {
                                if (!_openConsoleIds.Contains(s.Id))
                                {
                                    <option value="@s.Id">
                                        @s.Name (@s.Host:@s.RconPort)
                                    </option>
                                }
                            }
                        </select>

                        <button class="btn btn-sm btn-outline-light"
                                @onclick="AddConsole"
                                disabled="@string.IsNullOrEmpty(_selectedAddServerId)">
                            Add
                        </button>
                    </div>
                }
            </div>

            <div class="toolbar-section layout-section">
                <label class="server-select-label">Layout</label>
                <div class="btn-group btn-group-sm">
                    <button class="@GetLayoutButtonClass(1)" @onclick="@(() => SetLayout(1))" type="button">
                        <div class="layout-icon layout-icon-1">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </button>
                    <button class="@GetLayoutButtonClass(2)" @onclick="@(() => SetLayout(2))" type="button">
                        <div class="layout-icon layout-icon-2">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </button>
                    <button class="@GetLayoutButtonClass(3)" @onclick="@(() => SetLayout(3))" type="button">
                        <div class="layout-icon layout-icon-3">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        @if (_servers is null || !_servers.Any())
        {
            <p class="no-server-text">
                No servers configured. Go to <strong>Server Management</strong> to add one.
            </p>
        }
        else if (!_openConsoleIds.Any())
        {
            <p class="no-server-text">
                No consoles open. Use <strong>Add console</strong> to start monitoring a server.
            </p>
        }
        else
        {
            <div class="console-grid" style="grid-template-columns:@GridTemplateColumns">
                @foreach (var serverId in _openConsoleIds)
                {
                    var server = _servers!.FirstOrDefault(s => s.Id == serverId);
                    if (server is null)
                    {
                        continue;
                    }

                    <ServerConsole Server="server"
                                   State="GetConsoleState(serverId)"
                                   Commands="@GetCommands()"
                                   DefaultSayCommandId="@_defaultSayCommandId"
                                   CloseFiltersTick="@_closeFiltersTick"
                                   OnClose="@(() => CloseConsole(serverId))"
                                   OnPersistRequested="SavePersistedState" />
                }
            </div>
        }
    </div>

    <div class="help-panel">
        <h4>Minecraft Commands</h4>
        @if (_commands is null)
        {
            <p>Loading commands...</p>
        }
        else if (!_commands.Any())
        {
            <p class="no-command-text">No commands configured.</p>
        }
        else
        {
            <ul class="help-list">
                @foreach (var cmd in MinecraftCommandSyntax.OrderForDisplay(_commands))
                {
                    <li>
                        <button type="button"
                                class="help-command-btn @(IsCommandSelectedInConsoles(cmd) ? "selected" : "")"
                                title="Use this command"
                                @onclick="@(() => SelectCommand(cmd))">
                            <code>@cmd.Syntax</code>
                            @if (!string.IsNullOrWhiteSpace(cmd.Description))
                            {
                                <span class="help-command-desc"> – @cmd.Description</span>
                            }
                        </button>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private List<ServerConfig>? _servers;
    private List<MinecraftCommand>? _commands;
    private string? _defaultSayCommandId;
    private readonly List<string> _openConsoleIds = new();
    private readonly Dictionary<string, ConsoleState> _consoleStates = new();
    private string? _selectedAddServerId;
    private int _layoutColumns = 1;
    private long _closeFiltersTick;

    private string GridTemplateColumns => _layoutColumns switch
    {
        1 => "1fr",
        2 => "1fr 1fr",
        3 => "1fr 1fr 1fr",
        _ => "1fr"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _servers = (await ServerStore.GetAllAsync()).ToList();
        await LoadCommands();
        await LoadPersistedState();

        if (!_openConsoleIds.Any() && _servers.Any())
        {
            var firstId = _servers.FirstOrDefault()?.Id;
            if (firstId is not null)
            {
                _openConsoleIds.Add(firstId);
                await SavePersistedState();
            }
        }

        Navigation.LocationChanged += OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        await SavePersistedState();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var location = new Uri(e.Location);
        var baseUri = new Uri(Navigation.BaseUri);
        var relativePath = baseUri.MakeRelativeUri(location).ToString();

        if (relativePath is "" or "/" or "index.html")
        {
            _ = InvokeAsync(async () =>
            {
                await LoadCommands();
                StateHasChanged();
            });
        }
    }

    private async Task LoadCommands()
    {
        _commands = (await CommandStore.GetAllAsync()).ToList();
        _defaultSayCommandId = _commands
            .FirstOrDefault(c => MinecraftCommandSyntax.GetCommandName(c).Equals("say", StringComparison.OrdinalIgnoreCase))?.Id
            ?? _commands.FirstOrDefault()?.Id;

        foreach (var state in _consoleStates.Values)
        {
            if (string.IsNullOrEmpty(state.SelectedCommandId))
                state.SelectedCommandId = _defaultSayCommandId ?? string.Empty;
        }
    }

    private ConsoleState GetConsoleState(string serverId)
    {
        if (!_consoleStates.TryGetValue(serverId, out var state))
        {
            state = new ConsoleState(serverId);
            if (!string.IsNullOrEmpty(_defaultSayCommandId))
                state.SelectedCommandId = _defaultSayCommandId;
            _consoleStates[serverId] = state;
        }

        return state;
    }

    private async Task AddConsole()
    {
        if (string.IsNullOrWhiteSpace(_selectedAddServerId) || _openConsoleIds.Contains(_selectedAddServerId))
        {
            StateHasChanged();
            _selectedAddServerId = string.Empty;
            return;
        }

        _openConsoleIds.Add(_selectedAddServerId);
        await SavePersistedState();
        _selectedAddServerId = string.Empty;
        StateHasChanged();
    }

    private async Task CloseConsole(string serverId)
    {
        _openConsoleIds.Remove(serverId);
        await SavePersistedState();
        StateHasChanged();
    }

    private async Task SetLayout(int columns)
    {
        _layoutColumns = Math.Clamp(columns, 1, 3);
        await SavePersistedState();
        StateHasChanged();
    }

    private string GetLayoutButtonClass(int columns) =>
        "btn btn-sm " + (_layoutColumns == columns ? "btn-primary" : "btn-outline-light");

    private void SelectCommand(MinecraftCommand cmd)
    {
        foreach (var serverId in _openConsoleIds)
        {
            var state = GetConsoleState(serverId);
            state.SelectedCommandId = cmd.Id;
            state.CommandArguments = string.Empty;
        }

        StateHasChanged();
    }

    private bool IsCommandSelectedInConsoles(MinecraftCommand cmd) =>
        _openConsoleIds.Any() &&
        _openConsoleIds.All(id =>
            MinecraftCommandSyntax.ResolveSelectedCommandId(
                GetConsoleState(id), GetCommands(), _defaultSayCommandId) == cmd.Id);

    private IReadOnlyList<MinecraftCommand> GetCommands() =>
        _commands is null ? Array.Empty<MinecraftCommand>() : _commands;

    private void CloseAllFilterDropdowns()
    {
        _closeFiltersTick++;
        StateHasChanged();
    }

    private async Task LoadPersistedState()
    {
        var persisted = await ConsolePersistence.LoadAsync();
        if (persisted is null)
            return;

        if (_servers is not null && persisted.OpenConsoleIds is not null)
        {
            _openConsoleIds.Clear();
            _openConsoleIds.AddRange(
                persisted.OpenConsoleIds.Where(id => _servers.Any(s => s.Id == id)));
        }

        if (persisted.LayoutColumns is >= 1 and <= 3)
            _layoutColumns = persisted.LayoutColumns;

        if (persisted.ConsoleStates is null)
            return;

        foreach (var (serverId, toggle) in persisted.ConsoleStates)
        {
            var state = GetConsoleState(serverId);
            state.ShowLogs = toggle.ShowLogs;
            state.ShowCommands = toggle.ShowCommands;
            state.LevelFilterActive = toggle.LevelFilterActive;
            state.ThreadFilterActive = toggle.ThreadFilterActive;

            if (toggle.SelectedLogLevels is not null)
            {
                state.SelectedLogLevels = new HashSet<string>(toggle.SelectedLogLevels);
                if (toggle.SelectedLogLevels.Count > 0)
                    state.LevelFilterActive = true;
            }

            if (toggle.SelectedThreads is not null)
            {
                state.SelectedThreads = LogFilters.NormalizeThreadSelections(toggle.SelectedThreads);
                if (toggle.SelectedThreads.Count > 0)
                    state.ThreadFilterActive = true;
            }
        }
    }

    private async Task SavePersistedState()
    {
        var consoleStates = _openConsoleIds.ToDictionary(
            serverId => serverId,
            serverId =>
            {
                var state = GetConsoleState(serverId);
                return new ConsoleToggleState
                {
                    ShowLogs = state.ShowLogs,
                    ShowCommands = state.ShowCommands,
                    LevelFilterActive = state.LevelFilterActive,
                    ThreadFilterActive = state.ThreadFilterActive,
                    SelectedLogLevels = state.SelectedLogLevels.ToList(),
                    SelectedThreads = state.SelectedThreads.ToList()
                };
            });

        await ConsolePersistence.SaveAsync(new HomeConsolePersistedState
        {
            OpenConsoleIds = _openConsoleIds.ToList(),
            LayoutColumns = _layoutColumns,
            ConsoleStates = consoleStates
        });
    }
}
