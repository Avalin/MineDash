@page "/servers"
@rendermode InteractiveServer
@using MineDash.Models
@using MineDash.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IServerConfigStore ServerStore
@inject IAuthService AuthService
@inject ILogService LogService
@inject IRconService RconService
@inject IDockerComposeImportService ComposeImporter
@inject NavigationManager Navigation

<PageTitle>Server Management</PageTitle>

<div class="server-mgmt-layout">
    <div class="server-mgmt-header">
        <div>
            <h2>Server Management</h2>
            <p class="server-mgmt-subtitle">
                Configure manual servers or import Docker Compose-managed Minecraft servers.
            </p>
        </div>

        <div class="server-mgmt-actions">
            <button class="btn btn-secondary" @onclick="ToggleImportPanel">
                Import Docker Compose
            </button>
            <button class="btn btn-primary" @onclick="NewServer">
                + Add server
            </button>
        </div>
    </div>

    @if (_showImportPanel)
    {
        <div class="server-form-card import-compose-card">
            <h3 class="server-form-title">Import Docker Compose</h3>
            <p class="field-hint">
                Use a saved path for Compose-managed servers that can reload later, or upload a compose file once to create an editable manual server.
            </p>

            <div class="server-form-grid">
                <div class="field-row">
                    <div class="field-label">Compose-managed server</div>
                    <div class="field-hint">
                        Path to a <code>docker-compose.yml</code> visible from the MineDash server/container. Imported values are read-only and can be reloaded.
                    </div>
                    <div class="server-path-control">
                        <input class="form-control"
                               placeholder="/srv/minecraft/creatamon/docker-compose.yml"
                               @bind="_composeFilePath" />
                        <button class="btn btn-sm btn-outline-light"
                                type="button"
                                disabled="@_importingCompose"
                                @onclick="ImportManagedComposeFromPath">
                            @(_importingCompose ? "Importing..." : "Import managed")
                        </button>
                    </div>
                </div>

                <div class="field-row">
                    <div class="field-label">One-time import</div>
                    <div class="field-hint">
                        Upload a compose file to prefill a normal editable server. MineDash will not track the file after import.
                    </div>
                    <InputFile class="form-control" OnChange="ImportUploadedCompose" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_importMessage))
            {
                <div class="import-message">@_importMessage</div>
            }

            @if (_importWarnings.Count > 0)
            {
                <div class="import-warnings">
                    @foreach (var warning in _importWarnings)
                    {
                        <div>@warning</div>
                    }
                </div>
            }

            @if (_composeCandidates.Count > 1)
            {
                <div class="compose-candidates">
                    <div class="field-label">Choose a service to import</div>
                    @foreach (var candidate in _composeCandidates)
                    {
                        var selectedCandidate = candidate;
                        <button class="compose-candidate"
                                type="button"
                                @onclick="@(() => SaveImportedCandidate(selectedCandidate))">
                            <span class="compose-candidate-name">@GetCandidateDisplayName(candidate)</span>
                            <span class="compose-candidate-details">
                                @candidate.Host:@candidate.RconPort
                                @if (!string.IsNullOrWhiteSpace(candidate.Image))
                                {
                                    <span> · @candidate.Image</span>
                                }
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (_editServer is not null)
    {
        <div class="server-form-card">
            <h3 class="server-form-title">
                @(_isNew ? "Add server" : "Edit server")
                @if (IsComposeManaged)
                {
                    <span class="server-source-badge">Managed by Docker Compose</span>
                }
            </h3>

            @if (IsComposeManaged)
            {
                <div class="compose-managed-panel">
                    <div class="field-label">Managed by Docker Compose</div>
                    <div class="field-hint">
                        This server is controlled by its compose file. Reload from compose to update imported values.
                    </div>
                    <div class="compose-meta-grid">
                        <div>
                            <span>Compose file</span>
                            <code>@_editServer.ComposeFilePath</code>
                        </div>
                        <div>
                            <span>Service</span>
                            <code>@_editServer.ComposeServiceName</code>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_editServer.ComposeContainerName))
                        {
                            <div>
                                <span>Container</span>
                                <code>@_editServer.ComposeContainerName</code>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_editServer.ComposeImage))
                        {
                            <div>
                                <span>Image</span>
                                <code>@_editServer.ComposeImage</code>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_editServer.ComposeVersion))
                        {
                            <div>
                                <span>Version</span>
                                <code>@_editServer.ComposeVersion</code>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_editServer.ComposeMemory))
                        {
                            <div>
                                <span>Memory</span>
                                <code>@_editServer.ComposeMemory</code>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_editServer.ComposeDataVolumeSource))
                        {
                            <div>
                                <span>Data volume</span>
                                <code>@_editServer.ComposeDataVolumeSource:@_editServer.ComposeDataVolumeTarget</code>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="server-form-grid">
                <div class="field-row">
                    <div class="field-label">Name</div>
                    <div class="field-hint">
                        Friendly name for this server, shown in the Home dropdown.
                    </div>
                    <input class="form-control" value="@_editServer.Name" @oninput="OnNameInput" disabled="@IsComposeManaged" />
                    @if (!string.IsNullOrEmpty(_nameValidationError))
                    {
                        <div class="field-error">@_nameValidationError</div>
                    }
                </div>

                <div class="field-row">
                    <div class="field-label">Server host</div>
                    <div class="field-hint">
                        IP or hostname where the Minecraft server is reachable from this panel.
                        Docker Compose imports use the service or container name.
                    </div>
                    <input class="form-control" @bind="_editServer.Host" disabled="@IsComposeManaged" />
                </div>

                <div class="field-row field-row-half">
                    <div class="field-label">RCON port</div>
                    <div class="field-hint">
                        The port of the RCON interface (e.g. <code>25575</code>).
                    </div>
                    <input class="form-control" type="number" @bind="_editServer.RconPort" disabled="@IsComposeManaged" />
                </div>

                <div class="field-row field-row-half">
                    <div class="field-label">RCON password</div>
                    <div class="field-hint">
                        The password set as <code>rcon.password</code> (or the Docker env
                        <code>RCON_PASSWORD</code>).
                    </div>
                    <input class="form-control" type="password" @bind="_editServer.RconPassword" disabled="@IsComposeManaged" />
                </div>

                <div class="field-row">
                    <div class="field-label">Server folder path</div>
                    <div class="field-hint">
                        Path inside the MineDash container to this Minecraft server. Compose imports derive this from the data volume.
                    </div>
                    <div class="server-path-control">
                        <input class="form-control" placeholder="/srv/minecraft/creatamon" @bind="_editServer.LogPath" disabled="@IsComposeManaged" />
                        <button class="btn btn-sm btn-outline-light" type="button" disabled="@_testingServerAccess" @onclick="TestServerAccess">
                            @(_testingServerAccess ? "Testing..." : "Test server access")
                        </button>
                    </div>
                    @if (_serverAccessTestResult is not null)
                    {
                        <div class="server-access-test">
                            @foreach (var check in _serverAccessTestResult.Checks)
                            {
                                <div class="server-access-check @(check.Succeeded ? "success" : "error")">
                                    <span class="server-access-check-label @(check.Succeeded ? "success" : "error")">@check.Label</span>
                                    <span class="server-access-check-mark @(check.Succeeded ? "success" : "error")">@(check.Succeeded ? "✓" : "✗")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="field-row field-row-half">
                    <div class="field-label">Log timezone</div>
                    <div class="field-hint">
                        Timezone of timestamps inside <code>latest.log</code>. Docker servers usually use <code>UTC</code>.
                    </div>
                    <select class="form-control" @bind="_editServer.LogTimeZoneId" disabled="@IsComposeManaged">
                        @foreach (var option in GetLogTimeZoneOptions())
                        {
                            <option value="@option.Id">@option.Label</option>
                        }
                    </select>
                </div>
            </div>

            <div class="server-form-actions">
                @if (IsComposeManaged)
                {
                    <button class="btn btn-success" @onclick="ReloadComposeServer" disabled="@_reloadingCompose">
                        @(_reloadingCompose ? "Reloading..." : "Reload from compose")
                    </button>
                }
                else
                {
                    <button class="btn btn-success" @onclick="SaveServer">Save</button>
                }
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                @if (!_isNew && _selectedServer is not null)
                {
                    <button class="btn btn-danger" @onclick="ShowDeleteConfirmation">Delete</button>
                }
            </div>
        </div>
    }

    <ConfirmationDialog Show="@_showDeleteDialog"
                       Title="Delete Server"
                       Message="@($"Are you sure you want to delete the server '{_selectedServer?.Name}'? This action cannot be undone.")"
                       ConfirmText="Delete"
                       OnConfirmCallback="DeleteSelected"
                       OnCancelCallback="HideDeleteConfirmation" />

    <div class="server-table-card">
        @if (_servers.Count == 0)
        {
            <p class="no-server-text">
                No servers configured yet. Click <strong>Add server</strong> or <strong>Import Docker Compose</strong> to create one.
            </p>
        }
        else
        {
            <table class="table table-dark server-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Source</th>
                        <th>Host</th>
                        <th>RCON port</th>
                        <th style="width: 90px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _servers)
                    {
                        <tr class="@( _selectedServer?.Id == s.Id ? "selected-row" : "" )">
                            <td>@s.Name</td>
                            <td>@GetSourceLabel(s)</td>
                            <td>@s.Host</td>
                            <td>@s.RconPort</td>
                            <td>
                                <button class="btn btn-sm btn-secondary"
                                        @onclick="@(() => EditServer(s))">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private const long MaxUploadBytes = 1024 * 1024;

    private List<ServerConfig> _servers = new();
    private ServerConfig? _selectedServer;
    private ServerConfig? _editServer;
    private bool _isNew;
    private string? _nameValidationError;
    private bool _showDeleteDialog;
    private bool _testingServerAccess;
    private bool _showImportPanel;
    private bool _importingCompose;
    private bool _reloadingCompose;
    private string _composeFilePath = string.Empty;
    private string? _importMessage;
    private readonly List<string> _importWarnings = new();
    private readonly List<DockerComposeServerCandidate> _composeCandidates = new();
    private bool _pendingComposeManaged;
    private ServerAccessDiagnostics? _serverAccessTestResult;

    private bool IsComposeManaged => _editServer?.ConfigSource == ServerConfigSource.DockerCompose;

    private static readonly IReadOnlyList<LogTimeZoneOption> LogTimeZoneOptions =
    [
        new("UTC", "UTC (Docker default)"),
        new("Europe/Oslo", "Europe/Oslo"),
        new("Europe/Stockholm", "Europe/Stockholm"),
        new("Europe/Copenhagen", "Europe/Copenhagen"),
        new("Europe/Berlin", "Europe/Berlin"),
        new("W. Europe Standard Time", "W. Europe Standard Time")
    ];

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await RefreshServers();
        _selectedServer = _servers.FirstOrDefault();
    }

    private void NewServer()
    {
        _showImportPanel = false;
        _selectedServer = null;
        _editServer = new ServerConfig
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = "New Minecraft Server",
            ConfigSource = ServerConfigSource.Manual,
            Host = "localhost",
            RconPort = 25575,
            LogPath = "/srv/minecraft/creatamon",
            LogTimeZoneId = "UTC"
        };
        _isNew = true;
        ClearFormMessages();
    }

    private void EditServer(ServerConfig server)
    {
        _selectedServer = server;
        _editServer = CopyForEdit(server);
        _isNew = false;
        _composeFilePath = server.ComposeFilePath ?? _composeFilePath;
        ClearFormMessages();
    }

    private ServerConfig CopyForEdit(ServerConfig server) =>
        new()
        {
            Id = server.Id,
            Name = server.Name,
            ConfigSource = server.ConfigSource,
            Host = server.Host,
            RconPort = server.RconPort,
            RconPassword = server.RconPassword,
            LogPath = ToServerFolderPath(server.LogPath),
            LogTimeZoneId = NormalizeLogTimeZoneId(server.LogTimeZoneId),
            ComposeFilePath = server.ComposeFilePath,
            ComposeServiceName = server.ComposeServiceName,
            ComposeContainerName = server.ComposeContainerName,
            ComposeImage = server.ComposeImage,
            ComposeVersion = server.ComposeVersion,
            ComposeDataVolumeSource = server.ComposeDataVolumeSource,
            ComposeDataVolumeTarget = server.ComposeDataVolumeTarget,
            ComposeMemory = server.ComposeMemory
        };

    private async Task OnNameInput(ChangeEventArgs e)
    {
        if (_editServer is null || IsComposeManaged)
            return;

        _editServer.Name = e.Value?.ToString() ?? string.Empty;
        await ValidateServerName();
    }

    private Task ValidateServerName()
    {
        if (_editServer is null)
        {
            _nameValidationError = null;
            StateHasChanged();
            return Task.CompletedTask;
        }

        if (!_isNew && _selectedServer?.Name == _editServer.Name)
        {
            _nameValidationError = null;
            StateHasChanged();
            return Task.CompletedTask;
        }

        var trimmedName = _editServer.Name?.Trim();
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            _nameValidationError = "Server name is required.";
            StateHasChanged();
            return Task.CompletedTask;
        }

        var existingServer = _servers.FirstOrDefault(s =>
            s.Name.Equals(trimmedName, StringComparison.OrdinalIgnoreCase) &&
            (_isNew || s.Id != _editServer.Id));

        _nameValidationError = existingServer is not null
            ? "A server with this name already exists."
            : null;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SaveServer()
    {
        if (_editServer is null || IsComposeManaged)
            return;

        await ValidateServerName();
        if (!string.IsNullOrEmpty(_nameValidationError))
            return;

        _editServer.ConfigSource = ServerConfigSource.Manual;
        _editServer.LogPath = NormalizeServerFolderPath(_editServer.LogPath);
        _editServer.LogTimeZoneId = NormalizeLogTimeZoneId(_editServer.LogTimeZoneId);
        ClearComposeMetadata(_editServer);

        await ServerStore.AddOrUpdateAsync(_editServer);
        await RefreshAfterSave(_editServer.Id);
    }

    private void ToggleImportPanel()
    {
        _showImportPanel = !_showImportPanel;
        _editServer = null;
        _isNew = false;
        ClearFormMessages();
        ClearImportMessages();
    }

    private async Task ImportManagedComposeFromPath()
    {
        _importingCompose = true;
        ClearImportMessages();
        try
        {
            var result = await ComposeImporter.ImportFromPathAsync(_composeFilePath);
            await HandleImportResult(result, managedByCompose: true);
        }
        finally
        {
            _importingCompose = false;
        }
    }

    private async Task ImportUploadedCompose(InputFileChangeEventArgs e)
    {
        _importingCompose = true;
        ClearImportMessages();
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            var result = ComposeImporter.ImportFromContent(content, file.Name);
            await HandleImportResult(result, managedByCompose: false);
        }
        catch (IOException ex)
        {
            _importMessage = $"Could not read uploaded compose file: {ex.Message}";
        }
        finally
        {
            _importingCompose = false;
        }
    }

    private async Task HandleImportResult(DockerComposeImportResult result, bool managedByCompose)
    {
        _pendingComposeManaged = managedByCompose;
        _importWarnings.AddRange(result.Warnings);

        if (result.Candidates.Count == 0)
        {
            _importMessage = "No server was imported.";
            return;
        }

        _composeCandidates.AddRange(result.Candidates);
        if (result.Candidates.Count == 1)
        {
            await SaveImportedCandidate(result.Candidates[0]);
            return;
        }

        _importMessage = $"Found {result.Candidates.Count} Minecraft-like services.";
    }

    private async Task SaveImportedCandidate(DockerComposeServerCandidate candidate)
    {
        var server = ComposeImporter.CreateServerConfig(candidate, _pendingComposeManaged);
        EnsureUniqueServerName(server);
        server.LogPath = NormalizeServerFolderPath(server.LogPath);
        server.LogTimeZoneId = NormalizeLogTimeZoneId(server.LogTimeZoneId);

        await ServerStore.AddOrUpdateAsync(server);
        await RefreshServers();

        _selectedServer = _servers.FirstOrDefault(s => s.Id == server.Id);
        _editServer = _selectedServer is null ? null : CopyForEdit(_selectedServer);
        _isNew = false;
        _showImportPanel = false;
        ClearImportMessages();
    }

    private async Task ReloadComposeServer()
    {
        if (_editServer is null ||
            string.IsNullOrWhiteSpace(_editServer.ComposeFilePath))
        {
            _importMessage = "This server does not have a compose file path to reload.";
            return;
        }

        _reloadingCompose = true;
        ClearImportMessages();
        try
        {
            var result = await ComposeImporter.ImportFromPathAsync(_editServer.ComposeFilePath);
            var candidate = result.Candidates.FirstOrDefault(c =>
                string.Equals(c.ServiceName, _editServer.ComposeServiceName, StringComparison.OrdinalIgnoreCase));

            candidate ??= result.Candidates.Count == 1 ? result.Candidates[0] : null;
            if (candidate is null)
            {
                _importMessage = "Could not find the original compose service to reload.";
                _importWarnings.AddRange(result.Warnings);
                return;
            }

            var reloaded = ComposeImporter.CreateServerConfig(candidate, managedByCompose: true, existingId: _editServer.Id);
            reloaded.LogPath = NormalizeServerFolderPath(reloaded.LogPath);
            reloaded.LogTimeZoneId = NormalizeLogTimeZoneId(reloaded.LogTimeZoneId);
            await ServerStore.AddOrUpdateAsync(reloaded);
            await RefreshAfterSave(reloaded.Id);
        }
        finally
        {
            _reloadingCompose = false;
        }
    }

    private void EnsureUniqueServerName(ServerConfig server)
    {
        if (_servers is null || _servers.All(s => !s.Name.Equals(server.Name, StringComparison.OrdinalIgnoreCase)))
            return;

        var baseName = server.Name;
        for (var index = 2; ; index++)
        {
            var candidate = $"{baseName} ({index})";
            if (_servers.All(s => !s.Name.Equals(candidate, StringComparison.OrdinalIgnoreCase)))
            {
                server.Name = candidate;
                return;
            }
        }
    }

    private async Task TestServerAccess()
    {
        if (_editServer is null)
            return;

        _testingServerAccess = true;
        _serverAccessTestResult = null;
        StateHasChanged();

        try
        {
            _editServer.LogPath = NormalizeServerFolderPath(_editServer.LogPath);
            _serverAccessTestResult = await BuildServerAccessDiagnosticsAsync(_editServer);
        }
        finally
        {
            _testingServerAccess = false;
            StateHasChanged();
        }
    }

    private void ShowDeleteConfirmation()
    {
        _showDeleteDialog = true;
    }

    private void HideDeleteConfirmation()
    {
        _showDeleteDialog = false;
    }

    private async Task DeleteSelected()
    {
        if (_selectedServer is null)
            return;

        await ServerStore.DeleteAsync(_selectedServer.Id);

        await RefreshServers();
        _selectedServer = _servers.FirstOrDefault();
        _editServer = null;
        _isNew = false;
        _showDeleteDialog = false;
    }

    private void CancelEdit()
    {
        _editServer = null;
        _isNew = false;
        ClearFormMessages();
    }

    private async Task RefreshServers()
    {
        _servers = (await ServerStore.GetAllAsync()).ToList();
    }

    private async Task RefreshAfterSave(string serverId)
    {
        await RefreshServers();
        _selectedServer = _servers.FirstOrDefault(s => s.Id == serverId);
        _editServer = null;
        _isNew = false;
        ClearFormMessages();
    }

    private void ClearFormMessages()
    {
        _nameValidationError = null;
        _serverAccessTestResult = null;
    }

    private void ClearImportMessages()
    {
        _importMessage = null;
        _importWarnings.Clear();
        _composeCandidates.Clear();
    }

    private static void ClearComposeMetadata(ServerConfig server)
    {
        server.ComposeFilePath = null;
        server.ComposeServiceName = null;
        server.ComposeContainerName = null;
        server.ComposeImage = null;
        server.ComposeVersion = null;
        server.ComposeDataVolumeSource = null;
        server.ComposeDataVolumeTarget = null;
        server.ComposeMemory = null;
    }

    private IReadOnlyList<LogTimeZoneOption> GetLogTimeZoneOptions()
    {
        var current = NormalizeLogTimeZoneId(_editServer?.LogTimeZoneId);
        if (LogTimeZoneOptions.Any(option => option.Id == current))
            return LogTimeZoneOptions;

        return LogTimeZoneOptions
            .Append(new LogTimeZoneOption(current, $"{current} (current)"))
            .ToList();
    }

    private static string NormalizeLogTimeZoneId(string? timeZoneId) =>
        string.IsNullOrWhiteSpace(timeZoneId) ? "UTC" : timeZoneId.Trim();

    private async Task<ServerAccessDiagnostics> BuildServerAccessDiagnosticsAsync(ServerConfig server)
    {
        var rconStatus = await RconService.PingAsync(server);
        var rconCheck = rconStatus switch
        {
            ServerOnlineStatus.Online => new ServerAccessCheck(
                "Test RCON credentials",
                true),
            ServerOnlineStatus.AuthError => new ServerAccessCheck(
                "Test RCON credentials",
                false),
            _ => new ServerAccessCheck(
                "Test RCON credentials",
                false)
        };

        var logDiagnostics = await LogService.DiagnoseLogAccessAsync(server);
        var logCheck = logDiagnostics.Readable
            ? new ServerAccessCheck(
                "Locate the log",
                true)
            : new ServerAccessCheck(
                "Locate the log",
                false);

        var serverPropertiesPath = GetReadableServerPropertiesPath(server.LogPath);
        var propertiesCheck = serverPropertiesPath is not null
            ? new ServerAccessCheck(
                "Locate server.properties",
                true)
            : new ServerAccessCheck(
                "Locate server.properties",
                false);

        return new ServerAccessDiagnostics([rconCheck, logCheck, propertiesCheck]);
    }

    private static string NormalizeServerFolderPath(string? configuredPath)
    {
        var path = ToServerFolderPath(configuredPath);
        return path.TrimEnd('/', '\\');
    }

    private static string ToServerFolderPath(string? configuredPath)
    {
        var path = configuredPath?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(path))
            return string.Empty;

        const string dataLogSuffix = "/data/logs/latest.log";
        if (path.EndsWith(dataLogSuffix, StringComparison.OrdinalIgnoreCase))
            return path[..^dataLogSuffix.Length];

        const string logSuffix = "/logs/latest.log";
        if (path.EndsWith(logSuffix, StringComparison.OrdinalIgnoreCase))
            return path[..^logSuffix.Length];

        return path;
    }

    private static string? GetReadableServerPropertiesPath(string? serverFolderPath)
    {
        foreach (var candidate in GetServerPropertiesPathCandidates(serverFolderPath))
        {
            if (File.Exists(candidate))
                return candidate;
        }

        return null;
    }

    private static IEnumerable<string> GetServerPropertiesPathCandidates(string? serverFolderPath)
    {
        var folder = NormalizeServerFolderPath(serverFolderPath);
        if (string.IsNullOrWhiteSpace(folder))
            yield break;

        yield return CombinePath(folder, "data/server.properties");
        yield return CombinePath(folder, "server.properties");
    }

    private static string CombinePath(string basePath, string relativePath) =>
        $"{basePath.TrimEnd('/', '\\')}/{relativePath}";

    private static string GetSourceLabel(ServerConfig server) =>
        server.ConfigSource == ServerConfigSource.DockerCompose ? "Docker Compose" : "Manual";

    private static string GetCandidateDisplayName(DockerComposeServerCandidate candidate) =>
        string.IsNullOrWhiteSpace(candidate.ContainerName)
            ? candidate.ServiceName
            : candidate.ContainerName;

    private sealed record LogTimeZoneOption(string Id, string Label);
    private sealed record ServerAccessDiagnostics(IReadOnlyList<ServerAccessCheck> Checks);
    private sealed record ServerAccessCheck(string Label, bool Succeeded);
}
