@using MineDash.Models
@using MineDash.Services
@implements IAsyncDisposable
@inject IServerPlayerService PlayerService
@inject IAppSettingsStore AppSettingsStore

@if (Show)
{
    <div class="players-dialog-overlay" @onclick="Close">
        <div class="players-dialog" @onclick:stopPropagation="true">
            <div class="players-dialog-header">
                <div class="players-dialog-title-group">
                    <img src="/images/steve.png" alt="" class="players-dialog-title-icon" aria-hidden="true" />
                    <h5 class="players-dialog-title">Players — @Server.Name</h5>
                </div>
                <button type="button" class="players-dialog-close" aria-label="Close" @onclick="Close">
                    <span class="bi bi-x-lg"></span>
                </button>
            </div>

            <div class="players-dialog-tabs" role="tablist" aria-label="Player lists">
                <button type="button"
                        class="players-dialog-tab @(_activeTab == PlayersTab.Players ? "active" : null)"
                        role="tab"
                        aria-selected="@(_activeTab == PlayersTab.Players)"
                        @onclick="() => SelectTab(PlayersTab.Players)">
                    Players
                </button>
                <button type="button"
                        class="players-dialog-tab @(_activeTab == PlayersTab.Whitelist ? "active" : null)"
                        role="tab"
                        aria-selected="@(_activeTab == PlayersTab.Whitelist)"
                        @onclick="() => SelectTab(PlayersTab.Whitelist)">
                    Whitelist
                </button>
                <button type="button"
                        class="players-dialog-tab @(_activeTab == PlayersTab.Banned ? "active" : null)"
                        role="tab"
                        aria-selected="@(_activeTab == PlayersTab.Banned)"
                        @onclick="() => SelectTab(PlayersTab.Banned)">
                    Banned
                </button>
            </div>

            <div class="players-dialog-body">
                @if (_loading && _overview is null)
                {
                    <div class="players-dialog-status">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Loading players…</span>
                    </div>
                }
                else if (_overview is null)
                {
                    <div class="players-dialog-status players-dialog-error">
                        Could not load player data.
                    </div>
                }
                else
                {
                    @switch (_activeTab)
                    {
                        case PlayersTab.Players:
                            @RenderPlayersTab(_overview);
                            break;
                        case PlayersTab.Whitelist:
                            @RenderWhitelistTab(_overview);
                            break;
                        case PlayersTab.Banned:
                            @RenderBannedTab(_overview);
                            break;
                    }
                }
            </div>

            <div class="players-dialog-footer">
                <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ServerConfig Server { get; set; } = null!;
    [Parameter] public bool Show { get; set; }
    [Parameter] public IEnumerable<LogEntry>? LiveLogs { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private enum PlayersTab
    {
        Players,
        Whitelist,
        Banned
    }

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(3);

    private bool _loading;
    private bool _wasShown;
    private bool _playerAvatarsEnabled = true;
    private int _lastLiveLogCount = -1;
    private PlayersTab _activeTab = PlayersTab.Players;
    private ServerPlayersOverview? _overview;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnParametersSetAsync()
    {
        if (!Show)
        {
            _wasShown = false;
            _lastLiveLogCount = -1;
            _activeTab = PlayersTab.Players;
            StopPolling();
            return;
        }

        if (!_wasShown)
        {
            _wasShown = true;
            _lastLiveLogCount = LiveLogs?.Count() ?? 0;
            var settings = await AppSettingsStore.GetAsync();
            _playerAvatarsEnabled = settings.EnablePlayerAvatars;
            await LoadAsync(initial: true);
            StartPolling();
            return;
        }

        var logCount = LiveLogs?.Count() ?? 0;
        if (logCount != _lastLiveLogCount)
        {
            _lastLiveLogCount = logCount;
            await LoadAsync(initial: false);
        }
    }

    private void SelectTab(PlayersTab tab) => _activeTab = tab;

    private void StartPolling()
    {
        StopPolling();
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private void StopPolling()
    {
        if (_pollCts is null)
            return;

        _pollCts.Cancel();
        _pollCts.Dispose();
        _pollCts = null;
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(ct))
                await LoadAsync(initial: false);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadAsync(bool initial)
    {
        if (initial)
        {
            _loading = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            _overview = await PlayerService.GetPlayersOverviewAsync(Server, LiveLogs);
        }
        catch
        {
            if (initial)
                _overview = null;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private string GetAvatarUrl(string playerName) =>
        _playerAvatarsEnabled
            ? $"/api/players/{Uri.EscapeDataString(playerName)}/avatar"
            : "/images/steve.png";

    public async ValueTask DisposeAsync()
    {
        StopPolling();
        await Task.CompletedTask;
    }

    private RenderFragment RenderPlayersTab(ServerPlayersOverview overview) => __builder =>
    {
        if (!overview.Players.Any())
        {
            <div class="players-dialog-status">
                No players have connected to this server yet.
                @if (!overview.HasLogData && overview.OnlineLookupError is not null)
                {
                    <span class="players-dialog-hint">Could not read logs or query RCON.</span>
                }
            </div>
            return;
        }

        <div class="players-dialog-summary">
            @overview.OnlineCount online · @overview.Players.Count total
        </div>
        @if (overview.OnlineLookupError is not null)
        {
            <div class="players-dialog-warning">
                Online status unavailable — showing players from logs only.
            </div>
        }
        <ul class="players-dialog-list">
            @foreach (var player in overview.Players)
            {
                <li class="player-row">
                    <img src="@GetAvatarUrl(player.Name)" alt="" class="player-avatar @(player.IsOp ? "player-avatar-op" : null)" aria-hidden="true" />
                    <div class="player-info">
                        <span class="player-name">@player.Name</span>
                        @if (player.IsOp)
                        {
                            <span class="player-op-pill" title="Server operator">
                                <span class="bi bi-star-fill" aria-hidden="true"></span>
                                <span>OP</span>
                            </span>
                        }
                    </div>
                    <span class="player-status-pill @(player.IsOnline ? "status-online" : "status-offline")">
                        <span class="player-status-dot" aria-hidden="true"></span>
                        <span>@(player.IsOnline ? "Online" : "Offline")</span>
                    </span>
                </li>
            }
        </ul>
    };

    private RenderFragment RenderWhitelistTab(ServerPlayersOverview overview) => __builder =>
    {
        if (!overview.Whitelist.Any())
        {
            <div class="players-dialog-status">
                No players on the whitelist.
            </div>
            return;
        }

        var joined = overview.Whitelist.Count(e => e.Status != WhitelistPlayerStatus.Inactive);
        var online = overview.Whitelist.Count(e => e.Status == WhitelistPlayerStatus.Online);
        var inactive = overview.Whitelist.Count(e => e.Status == WhitelistPlayerStatus.Inactive);

        <div class="players-dialog-summary">
            @online online · @joined joined · @overview.Whitelist.Count total
            @if (inactive > 0)
            {
                <span>· @inactive inactive</span>
            }
        </div>
        <ul class="players-dialog-list">
            @foreach (var entry in overview.Whitelist)
            {
                <li class="player-row">
                    <img src="@GetAvatarUrl(entry.DisplayName)" alt="" class="player-avatar @(entry.IsOp ? "player-avatar-op" : null)" aria-hidden="true" />
                    <div class="player-info">
                        <span class="player-name">@entry.DisplayName</span>
                        @if (entry.IsOp)
                        {
                            <span class="player-op-pill" title="Server operator">
                                <span class="bi bi-star-fill" aria-hidden="true"></span>
                                <span>OP</span>
                            </span>
                        }
                    </div>
                    @RenderWhitelistStatus(entry.Status)
                </li>
            }
        </ul>
    };

    private RenderFragment RenderBannedTab(ServerPlayersOverview overview) => __builder =>
    {
        if (!overview.Bans.Any())
        {
            <div class="players-dialog-status">
                No banned players.
            </div>
            return;
        }

        <div class="players-dialog-summary">
            @overview.Bans.Count banned
        </div>
        <ul class="players-dialog-list">
            @foreach (var entry in overview.Bans)
            {
                <li class="player-row player-row-ban">
                    <img src="@GetAvatarUrl(entry.DisplayName)" alt="" class="player-avatar" aria-hidden="true" />
                    <div class="player-info player-info-ban">
                        <span class="player-name">@entry.DisplayName</span>
                        @if (!string.IsNullOrWhiteSpace(entry.Reason))
                        {
                            <span class="player-ban-reason" title="@entry.Reason">@entry.Reason</span>
                        }
                    </div>
                </li>
            }
        </ul>
    };

    private RenderFragment RenderWhitelistStatus(WhitelistPlayerStatus status) => __builder =>
    {
        switch (status)
        {
            case WhitelistPlayerStatus.Inactive:
                <span class="player-status-pill status-inactive">
                    <span class="player-status-dot" aria-hidden="true"></span>
                    <span>Inactive</span>
                </span>
                break;
            case WhitelistPlayerStatus.Online:
                <span class="player-status-pill status-online">
                    <span class="player-status-dot" aria-hidden="true"></span>
                    <span>Online</span>
                </span>
                break;
            default:
                <span class="player-status-pill status-offline">
                    <span class="player-status-dot" aria-hidden="true"></span>
                    <span>Offline</span>
                </span>
                break;
        }
    };
}
