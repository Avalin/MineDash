@using MineDash.Models
@using MineDash.Services
@implements IAsyncDisposable
@inject IServerPlayerService PlayerService
@inject IAppSettingsStore AppSettingsStore

@if (Show)
{
    <div class="players-dialog-overlay" @onclick="Close">
        <div class="players-dialog" @onclick:stopPropagation="true">
            <div class="players-dialog-header">
                <div class="players-dialog-title-group">
                    <img src="/images/steve.png" alt="" class="players-dialog-title-icon" aria-hidden="true" />
                    <h5 class="players-dialog-title">Players — @Server.Name</h5>
                </div>
                <button type="button" class="players-dialog-close" aria-label="Close" @onclick="Close">
                    <span class="bi bi-x-lg"></span>
                </button>
            </div>
            <div class="players-dialog-body">
                @if (_loading && _result is null)
                {
                    <div class="players-dialog-status">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Loading players…</span>
                    </div>
                }
                else if (_result is null)
                {
                    <div class="players-dialog-status players-dialog-error">
                        Could not load player data.
                    </div>
                }
                else if (!_result.Players.Any())
                {
                    <div class="players-dialog-status">
                        No players have connected to this server yet.
                        @if (!_result.HasLogData && _result.OnlineLookupError is not null)
                        {
                            <span class="players-dialog-hint">Could not read logs or query RCON.</span>
                        }
                    </div>
                }
                else
                {
                    <div class="players-dialog-summary">
                        @_result.OnlineCount online · @_result.Players.Count total
                        @if (_refreshing)
                        {
                            <span class="players-dialog-live" aria-live="polite">Updating…</span>
                        }
                    </div>
                    @if (_result.OnlineLookupError is not null)
                    {
                        <div class="players-dialog-warning">
                            Online status unavailable — showing players from logs only.
                        </div>
                    }
                    <ul class="players-dialog-list">
                        @foreach (var player in _result.Players)
                        {
                            <li class="player-row">
                                <img src="@GetAvatarUrl(player.Name)" alt="" class="player-avatar" aria-hidden="true" />
                                <span class="player-name">@player.Name</span>
                                <span class="player-status-pill @(player.IsOnline ? "status-online" : "status-offline")">
                                    <span class="player-status-dot" aria-hidden="true"></span>
                                    <span>@(player.IsOnline ? "Online" : "Offline")</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="players-dialog-footer">
                <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ServerConfig Server { get; set; } = null!;
    [Parameter] public bool Show { get; set; }
    [Parameter] public IEnumerable<LogEntry>? LiveLogs { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(3);

    private bool _loading;
    private bool _refreshing;
    private bool _wasShown;
    private bool _playerAvatarsEnabled = true;
    private int _lastLiveLogCount = -1;
    private ServerPlayersResult? _result;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnParametersSetAsync()
    {
        if (!Show)
        {
            _wasShown = false;
            _lastLiveLogCount = -1;
            StopPolling();
            return;
        }

        if (!_wasShown)
        {
            _wasShown = true;
            _lastLiveLogCount = LiveLogs?.Count() ?? 0;
            var settings = await AppSettingsStore.GetAsync();
            _playerAvatarsEnabled = settings.EnablePlayerAvatars;
            await LoadAsync(initial: true);
            StartPolling();
            return;
        }

        var logCount = LiveLogs?.Count() ?? 0;
        if (logCount != _lastLiveLogCount)
        {
            _lastLiveLogCount = logCount;
            await LoadAsync(initial: false);
        }
    }

    private void StartPolling()
    {
        StopPolling();
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private void StopPolling()
    {
        if (_pollCts is null)
            return;

        _pollCts.Cancel();
        _pollCts.Dispose();
        _pollCts = null;
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(ct))
                await LoadAsync(initial: false);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadAsync(bool initial)
    {
        if (initial)
        {
            _loading = true;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            _refreshing = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            _result = await PlayerService.GetPlayersAsync(Server, LiveLogs);
        }
        catch
        {
            if (initial)
                _result = null;
        }
        finally
        {
            _loading = false;
            _refreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private string GetAvatarUrl(string playerName) =>
        _playerAvatarsEnabled
            ? $"/api/players/{Uri.EscapeDataString(playerName)}/avatar"
            : "/images/steve.png";

    public async ValueTask DisposeAsync()
    {
        StopPolling();
        await Task.CompletedTask;
    }
}
