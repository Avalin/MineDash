@rendermode InteractiveServer
@using MineDash.Models
@using MineDash.Services
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IRconService Rcon
@inject IAuthService AuthService
@inject IConsoleActivityStore ConsoleActivity
@inject IConsoleLogFilterService LogFilters
@inject IConsoleTimelineService Timeline
@inject IConsoleLogSessionService LogSession
@inject IConsoleLogRetentionService LogRetention
@inject ILogPlayerHighlighter PlayerHighlighter
@inject ITimeDisplayService TimeDisplay
@inject IJSRuntime JSRuntime

<div class="console-card @(State.MobileExpanded ? "mobile-expanded" : "mobile-collapsed")">
    <div class="console-header console-header-summary">
        <div class="console-header-title">
            <div class="console-title">@Server.Name</div>
            <div class="console-endpoint">@Server.Host:@Server.RconPort</div>
        </div>
        <div class="console-header-actions">
            <span class="server-status-pill @GetStatusPillClass()"
                  title="@GetStatusTooltip()">
                <span class="server-status-dot" aria-hidden="true"></span>
                <span class="server-status-label">@GetStatusLabel()</span>
            </span>
            <button class="console-close-btn" title="Close console" type="button" @onclick="OnClose">
                <span class="bi bi-x-lg"></span>
            </button>
        </div>
    </div>

    <button class="console-mobile-toggle"
            type="button"
            aria-expanded="@State.MobileExpanded"
            @onclick="ToggleMobileExpanded">
        <span class="bi @(State.MobileExpanded ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
        <span>Console</span>
    </button>

    <div class="console-card-body">
        <div class="console-header-buttons">
            @{
                IReadOnlyCollection<string> availableLevels = State.ShowLogs && State.LiveLogs.Any()
                    ? LogFilters.GetAvailableLevels(State)
                    : Array.Empty<string>();
                IReadOnlyCollection<string> availableThreads = State.ShowLogs && State.LiveLogs.Any()
                    ? LogFilters.GetAvailableThreads(State)
                    : Array.Empty<string>();
                IReadOnlyList<string> threadsForUi = availableThreads.Any()
                    ? LogFilters.GetThreadsForFilterUi(State)
                    : Array.Empty<string>();
                var pinnedThreads = threadsForUi.Where(ConsoleThreadNormalizer.IsPinnedThread).ToList();
                var otherThreads = threadsForUi.Where(t => !ConsoleThreadNormalizer.IsPinnedThread(t)).ToList();
                var activeViewCount = GetActiveViewCount();
                var activeFilterCount = GetActiveFilterCount();
            }
            <div class="filter-dropdown console-options-dropdown">
                <button class="filter-dropdown-btn console-options-btn @(activeViewCount > 0 ? "has-filter" : "")"
                        type="button"
                        title="View settings"
                        aria-label="View settings"
                        @onclick="@(() => ToggleFilterDropdown("view"))"
                        @onclick:stopPropagation="true">
                    <span class="bi bi-sliders"></span>
                    <span class="console-options-label">View</span>
                    @if (activeViewCount > 0)
                    {
                        <span class="filter-badge">@activeViewCount</span>
                    }
                </button>
                @if (State.OpenFilterDropdown == "view")
                {
                    <div class="filter-dropdown-menu console-options-menu" @onclick:stopPropagation="true">
                        <button class="console-options-close"
                                type="button"
                                aria-label="Close view settings"
                                @onclick="CloseFilterDropdown">
                            <span class="bi bi-x-lg"></span>
                        </button>
                        <div class="console-options-section">
                            <button class="console-options-section-title"
                                    type="button"
                                    @onclick="@(() => ToggleOptionSection("display"))">
                                <span class="bi bi-eye"></span>
                                <span>Display</span>
                                <span class="filter-badge">@GetDisplaySummary()</span>
                                <span class="bi @GetOptionSectionChevron("display")"></span>
                            </button>
                            @if (IsOptionSectionExpanded("display"))
                            {
                                <label class="filter-dropdown-item">
                                    <input type="checkbox"
                                           checked="@State.ShowLogs"
                                           @onchange="@(_ => ToggleLogs())" />
                                    <span>Logs</span>
                                </label>
                                <label class="filter-dropdown-item">
                                    <input type="checkbox"
                                           checked="@State.ShowCommands"
                                           @onchange="@(_ => ToggleCommands())" />
                                    <span>Commands</span>
                                </label>
                            }
                        </div>

                        @if (State.ShowLogs)
                        {
                            <div class="console-options-section">
                                <button class="console-options-section-title"
                                        type="button"
                                        @onclick="@(() => ToggleOptionSection("time"))">
                                    <span class="bi bi-clock-history"></span>
                                    <span>Log history</span>
                                    <span class="filter-badge">@LogRetention.FormatTimeShort(State.LogHistoryMinutes)</span>
                                    <span class="bi @GetOptionSectionChevron("time")"></span>
                                </button>
                                @if (IsOptionSectionExpanded("time"))
                                {
                                    @foreach (var preset in LogHistoryPresets.Time)
                                    {
                                        <label class="filter-dropdown-item">
                                            <input type="radio"
                                                   name="@($"log-time-{State.ServerId}")"
                                                   checked="@(State.LogHistoryMinutes == preset.Minutes)"
                                                   @onchange="@(() => OnTimeLimitChanged(preset.Minutes))" />
                                            <span>@preset.Label</span>
                                        </label>
                                    }
                                }
                            </div>

                            <div class="console-options-section">
                                <button class="console-options-section-title"
                                        type="button"
                                        @onclick="@(() => ToggleOptionSection("lines"))">
                                    <span class="bi bi-list-ol"></span>
                                    <span>Line limit</span>
                                    <span class="filter-badge">@LogRetention.FormatLineShort(State.LogLineLimit)</span>
                                    <span class="bi @GetOptionSectionChevron("lines")"></span>
                                </button>
                                @if (IsOptionSectionExpanded("lines"))
                                {
                                    @foreach (var preset in LogHistoryPresets.Lines)
                                    {
                                        <label class="filter-dropdown-item">
                                            <input type="radio"
                                                   name="@($"log-lines-{State.ServerId}")"
                                                   checked="@(State.LogLineLimit == preset.Lines)"
                                                   @onchange="@(() => OnLineLimitChanged(preset.Lines))" />
                                            <span>@preset.Label</span>
                                        </label>
                                    }
                                }
                            </div>
                        }

                        <div class="console-options-section">
                            <button class="console-options-section-title"
                                    type="button"
                                    @onclick="@(() => ToggleOptionSection("scroll"))">
                                <span class="bi bi-arrow-down-circle"></span>
                                <span>Autoscroll</span>
                                <span class="filter-badge">@ConsoleAutoscrollPresets.GetShortLabel(State.AutoscrollMode)</span>
                                <span class="bi @GetOptionSectionChevron("scroll")"></span>
                            </button>
                            @if (IsOptionSectionExpanded("scroll"))
                            {
                                @foreach (var preset in ConsoleAutoscrollPresets.Modes)
                                {
                                    <label class="filter-dropdown-item" title="@preset.Description">
                                        <input type="radio"
                                               name="@($"autoscroll-{State.ServerId}")"
                                               checked="@(State.AutoscrollMode == preset.Mode)"
                                               @onchange="@(() => OnAutoscrollModeChanged(preset.Mode))" />
                                        <span>@preset.Label</span>
                                    </label>
                                }
                            }
                        </div>

                    </div>
                }
            </div>
            <div class="filter-dropdown console-options-dropdown">
                <button class="filter-dropdown-btn console-options-btn @(activeFilterCount > 0 ? "has-filter" : "")"
                        type="button"
                        title="Log filters"
                        aria-label="Log filters"
                        @onclick="@(() => ToggleFilterDropdown("filters"))"
                        @onclick:stopPropagation="true">
                    <span class="bi bi-funnel"></span>
                    <span class="console-options-label">Filters</span>
                    @if (activeFilterCount > 0)
                    {
                        <span class="filter-badge">@activeFilterCount</span>
                    }
                </button>
                @if (State.OpenFilterDropdown == "filters")
                {
                    <div class="filter-dropdown-menu console-options-menu" @onclick:stopPropagation="true">
                        <button class="console-options-close"
                                type="button"
                                aria-label="Close filters"
                                @onclick="CloseFilterDropdown">
                            <span class="bi bi-x-lg"></span>
                        </button>
                        @if (!availableLevels.Any() && !availableThreads.Any())
                        {
                            <div class="console-options-empty">
                                No log filters available yet.
                            </div>
                        }

                        @if (availableLevels.Any())
                        {
                            <div class="console-options-section">
                                <button class="console-options-section-title"
                                        type="button"
                                        @onclick="@(() => ToggleOptionSection("levels"))">
                                    <span class="bi bi-funnel"></span>
                                    <span>Log levels</span>
                                    <span class="filter-badge">@LogFilters.GetLevelBadgeCount(State)</span>
                                    <span class="bi @GetOptionSectionChevron("levels")"></span>
                                </button>
                                @if (IsOptionSectionExpanded("levels"))
                                {
                                    @foreach (var level in availableLevels.OrderBy(l => l))
                                    {
                                        var isChecked = !State.LevelFilterActive || State.SelectedLogLevels.Contains(level);
                                        <label class="filter-dropdown-item">
                                            <input type="checkbox"
                                                   checked="@isChecked"
                                                   @onchange="@((ChangeEventArgs e) => ToggleLogLevel(level, e.Value?.ToString() == "True"))" />
                                            <span>@level</span>
                                        </label>
                                    }
                                }
                            </div>
                        }

                        @if (availableThreads.Any())
                        {
                            <div class="console-options-section">
                                <button class="console-options-section-title"
                                        type="button"
                                        @onclick="@(() => ToggleOptionSection("threads"))">
                                    <span class="bi bi-funnel"></span>
                                    <span>Threads</span>
                                    <span class="filter-badge">@LogFilters.GetThreadBadgeCount(State)</span>
                                    <span class="bi @GetOptionSectionChevron("threads")"></span>
                                </button>
                                @if (IsOptionSectionExpanded("threads"))
                                {
                                    <div class="filter-dropdown-actions">
                                        <button type="button" class="filter-dropdown-action" @onclick="SelectAllThreads">
                                            Select all
                                        </button>
                                        <button type="button" class="filter-dropdown-action" @onclick="DeselectAllThreads">
                                            Deselect all
                                        </button>
                                    </div>
                                    @foreach (var thread in pinnedThreads)
                                    {
                                        var isChecked = !State.ThreadFilterActive || State.SelectedThreads.Contains(thread);
                                        var isAbsent = !availableThreads.Contains(thread);
                                        <label class="filter-dropdown-item filter-dropdown-item-pinned @(isAbsent ? "filter-dropdown-item-absent" : "")"
                                               title="@ConsoleThreadNormalizer.GetThreadTooltip(thread)">
                                            <input type="checkbox"
                                                   checked="@isChecked"
                                                   @onchange="@((ChangeEventArgs e) => ToggleThread(thread, e.Value?.ToString() == "True"))" />
                                            <span>@ConsoleThreadNormalizer.GetThreadDisplayName(thread)</span>
                                        </label>
                                    }
                                    @if (pinnedThreads.Count > 0 && otherThreads.Count > 0)
                                    {
                                        <div class="filter-dropdown-divider" role="separator"></div>
                                    }
                                    @foreach (var thread in otherThreads)
                                    {
                                        var isChecked = !State.ThreadFilterActive || State.SelectedThreads.Contains(thread);
                                        <label class="filter-dropdown-item"
                                               title="@ConsoleThreadNormalizer.GetThreadTooltip(thread)">
                                            <input type="checkbox"
                                                   checked="@isChecked"
                                                   @onchange="@((ChangeEventArgs e) => ToggleThread(thread, e.Value?.ToString() == "True"))" />
                                            <span>@ConsoleThreadNormalizer.GetThreadDisplayName(thread)</span>
                                        </label>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="filter-dropdown console-options-dropdown">
                <button class="filter-dropdown-btn console-options-btn console-players-btn"
                        type="button"
                        title="Players"
                        aria-label="Players"
                        @onclick="OpenPlayersDialog"
                        @onclick:stopPropagation="true">
                    <img src="/images/steve.png" alt="" class="players-btn-icon" width="14" height="14" aria-hidden="true" />
                    <span class="console-options-label">Players</span>
                </button>
            </div>
        </div>

        <div class="console-output" id="@OutputElementId">
        @{
            var mergedEntries = Timeline.BuildMergedEntries(State, ConsoleActivity.GetHistory(State.ServerId));
        }
        @if (State.ShowLogs && State.LiveLogs.Any() && !mergedEntries.Any(e => e.IsLog) && LogFilters.HasActiveFilters(State))
        {
            <div class="console-hint">
                Log lines are hidden by your level/thread filters. Clear filters to see chat and server output.
            </div>
        }
        @if (State.ShowLogs && !State.LiveLogs.Any() && !string.IsNullOrWhiteSpace(Server.LogPath))
        {
            <div class="console-hint">
                Watching <code>@Server.LogPath</code> — waiting for log lines. Toggle the journal icon off/on to reload.
            </div>
        }
        @if (mergedEntries.Any())
        {
            var knownPlayerNames = PlayerHighlighter.CollectPlayerNames(State.LiveLogs);
            @foreach (var entry in mergedEntries)
            {
                @if (entry.IsLog)
                {
                    var messageClass = ConsoleLogAppearance.GetMessageClasses(
                        entry.LevelKey, entry.ThreadKey, entry.LogLine);
                    <div class="console-log-entry">
                        <span class="console-log-time">[@TimeDisplay.FormatTime(entry.Timestamp)]</span>
                        <span class="console-log-message @messageClass">@((MarkupString)PlayerHighlighter.Highlight(entry.LogLine ?? string.Empty, knownPlayerNames))</span>
                    </div>
                }
                else
                {
                    <div class="console-entry">
                        <div class="console-command">
                            <span class="console-log-time">[@TimeDisplay.FormatTime(entry.Timestamp)]</span>
                            <span class="console-prefix">&gt;</span>
                            <span>@entry.Command</span>
                            @if (!string.IsNullOrWhiteSpace(entry.ExecutedBy))
                            {
                                <span class="command-user">(@entry.ExecutedBy)</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(entry.Response))
                        {
                            <div class="console-response">@entry.Response</div>
                        }
                    </div>
                }
            }
        }
        else
        {
            <div class="console-empty">
                @if (!State.ShowLogs && !State.ShowCommands)
                {
                    <text>Both logs and commands are hidden. Use the toggle buttons to show them.</text>
                }
                else if (State.ShowLogs && !State.ShowCommands && !State.LiveLogs.Any())
                {
                    @if (string.IsNullOrWhiteSpace(Server.LogPath))
                    {
                        <text>No log path configured. Set the log file path in Server Management.<br />
                        <small>Example: <code>/srv/minecraft/cobbleverse/data/logs/latest.log</code></small></text>
                    }
                    else
                    {
                        <text>No logs available. Checking path: <code>@Server.LogPath</code><br />
                        <small>Make sure the file exists and is readable. Check container logs for details.</small></text>
                    }
                }
                else if (!State.ShowLogs && State.ShowCommands && !ConsoleActivity.GetHistory(State.ServerId).Any())
                {
                    <text>No commands sent yet.</text>
                }
                else
                {
                    <text>No entries to display.</text>
                }
            </div>
        }
    </div>

    @{
        var selectedCmd = MinecraftCommandSyntax.GetSelectedCommand(State, Commands, DefaultSayCommandId);
        var argsHint = selectedCmd is not null ? MinecraftCommandSyntax.GetArgumentsHint(selectedCmd) : string.Empty;
        var acceptsArgs = selectedCmd is not null && MinecraftCommandSyntax.AcceptsArguments(selectedCmd);
    }
        <div class="command-input-row">
            <div class="command-select-wrap"
                 data-value="@(selectedCmd is not null ? MinecraftCommandSyntax.GetDisplayName(selectedCmd) : "say")">
                <select class="form-select command-select"
                        value="@MinecraftCommandSyntax.ResolveSelectedCommandId(State, Commands, DefaultSayCommandId)"
                        @onchange="OnCommandTypeChanged">
                    @foreach (var cmd in MinecraftCommandSyntax.OrderForDisplay(Commands))
                    {
                        <option value="@cmd.Id" title="@cmd.Description">@MinecraftCommandSyntax.GetDisplayName(cmd)</option>
                    }
                </select>
            </div>

            <input class="form-control command-input"
                   placeholder="@(acceptsArgs ? argsHint : "No arguments needed")"
                   value="@State.CommandArguments"
                   disabled="@(!acceptsArgs)"
                   @oninput="OnCommandArgumentsChanged"
                   @onkeydown="HandleKeyDown" />

            <button class="btn btn-primary command-send-btn"
                    @onclick="SendCommand"
                    disabled="@(!MinecraftCommandSyntax.CanSend(State, selectedCmd))">
                Send
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ServerConfig Server { get; set; } = null!;
    [Parameter, EditorRequired] public ConsoleState State { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<MinecraftCommand> Commands { get; set; } = Array.Empty<MinecraftCommand>();
    [Parameter] public string? DefaultSayCommandId { get; set; }
    [Parameter] public long CloseFiltersTick { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPlayersClick { get; set; }
    [Parameter] public EventCallback OnPersistRequested { get; set; }

    private CancellationTokenSource? _pollCts;
    private CancellationTokenSource? _statusCts;
    private long _lastCloseFiltersTick;
    private int _statusCheckRunning;
    private bool _stickToBottomForAuto;
    private bool _pendingInitialScroll;
    private DateTime _lastReconnectAttemptUtc = DateTime.MinValue;
    private readonly HashSet<string> _expandedOptionSections = new(StringComparer.Ordinal);
    private static readonly TimeSpan StatusCheckInterval = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan ReconnectBackoff = TimeSpan.FromSeconds(30);
    private string OutputElementId => $"console-output-{State.ServerId}";

    protected override async Task OnInitializedAsync()
    {
        ConsoleActivity.HistoryChanged += OnHistoryChanged;
        StartStatusPolling();
        await StartLogWatchingAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingInitialScroll && !firstRender)
            return;

        if (_pendingInitialScroll)
            _pendingInitialScroll = false;

        _stickToBottomForAuto = true;
        await Task.Delay(firstRender ? 100 : 50);
        await AfterContentUpdateAsync(contentAdded: true, legacyOffScroll: true);
    }

    protected override void OnParametersSet()
    {
        if (CloseFiltersTick != _lastCloseFiltersTick)
        {
            State.OpenFilterDropdown = null;
            _lastCloseFiltersTick = CloseFiltersTick;
        }
    }

    public async ValueTask DisposeAsync()
    {
        ConsoleActivity.HistoryChanged -= OnHistoryChanged;
        StopLogPolling();
        StopStatusPolling();
        await Task.CompletedTask;
    }

    private void OnHistoryChanged(string serverId)
    {
        if (!string.Equals(serverId, State.ServerId, StringComparison.Ordinal))
            return;

        _ = InvokeAsync(async () =>
        {
            await PrepareAutoscrollCheckAsync();
            await LogSession.PollLogsAsync(Server, State);
            StateHasChanged();
            await AfterContentUpdateAsync(contentAdded: true, legacyOffScroll: true);
        });
    }

    private async Task StartLogWatchingAsync()
    {
        if (string.IsNullOrWhiteSpace(Server.LogPath?.Trim()))
            return;

        await LogSession.LoadRecentLogsAsync(Server, State);
        StartLogPolling();
        _pendingInitialScroll = true;
        await InvokeAsync(StateHasChanged);
    }

    private void StartLogPolling()
    {
        StopLogPolling();
        _pollCts = new CancellationTokenSource();
        _ = PollLogsLoopAsync(_pollCts.Token);
    }

    private void StopLogPolling()
    {
        if (_pollCts is null)
            return;

        _pollCts.Cancel();
        _pollCts.Dispose();
        _pollCts = null;
    }

    private void StartStatusPolling()
    {
        StopStatusPolling();
        _statusCts = new CancellationTokenSource();
        _ = StatusPollLoopAsync(_statusCts.Token);
    }

    private void StopStatusPolling()
    {
        if (_statusCts is null)
            return;

        _statusCts.Cancel();
        _statusCts.Dispose();
        _statusCts = null;
    }

    private async Task StatusPollLoopAsync(CancellationToken ct)
    {
        try
        {
            await CheckServerStatusAsync(initial: true);

            using var timer = new PeriodicTimer(StatusCheckInterval);
            while (await timer.WaitForNextTickAsync(ct))
                await CheckServerStatusAsync(initial: false);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PollLogsLoopAsync(CancellationToken ct)
    {
        try
        {
            await PollOnceAsync(legacyOffScroll: false);

            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(ct))
                await PollOnceAsync(legacyOffScroll: false);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PollOnceAsync(bool legacyOffScroll)
    {
        await PrepareAutoscrollCheckAsync();
        var logCountBefore = State.LiveLogs.Count;

        await LogSession.PollLogsAsync(Server, State);
        var contentAdded = State.LiveLogs.Count > logCountBefore;

        if (State.ShowLogs)
            await InvokeAsync(StateHasChanged);

        await AfterContentUpdateAsync(contentAdded, legacyOffScroll);
    }

    private async Task RefreshLogsAfterCommandAsync()
    {
        for (var i = 0; i < 8; i++)
        {
            await Task.Delay(250);
            await Task.Delay(250);
            await PollOnceAsync(legacyOffScroll: true);
        }
    }

    private async Task OnAutoscrollModeChanged(ConsoleAutoscrollMode mode)
    {
        State.AutoscrollMode = mode;
        State.OpenFilterDropdown = null;
        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private void ToggleFilterDropdown(string dropdownType)
    {
        State.OpenFilterDropdown = State.OpenFilterDropdown == dropdownType ? null : dropdownType;
        StateHasChanged();
    }

    private void CloseFilterDropdown()
    {
        State.OpenFilterDropdown = null;
        StateHasChanged();
    }

    private async Task OpenPlayersDialog()
    {
        State.OpenFilterDropdown = null;
        if (OnPlayersClick.HasDelegate)
            await OnPlayersClick.InvokeAsync();
    }

    private async Task ToggleMobileExpanded()
    {
        State.MobileExpanded = !State.MobileExpanded;
        if (!State.MobileExpanded)
            State.OpenFilterDropdown = null;

        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private int GetActiveViewCount()
    {
        var count = 0;
        if (!State.ShowLogs)
            count++;

        if (!State.ShowCommands)
            count++;

        if (State.AutoscrollMode != ConsoleAutoscrollMode.Off)
            count++;

        return count;
    }

    private int GetActiveFilterCount()
    {
        var count = 0;
        if (LogFilters.IsLevelFilterRestricting(State))
            count++;

        if (LogFilters.IsThreadFilterRestricting(State))
            count++;

        return count;
    }

    private string GetDisplaySummary()
    {
        if (State.ShowLogs && State.ShowCommands)
            return "All";

        if (State.ShowLogs)
            return "Logs";

        return State.ShowCommands ? "Cmd" : "None";
    }

    private bool IsOptionSectionExpanded(string section) =>
        _expandedOptionSections.Contains(section);

    private void ToggleOptionSection(string section)
    {
        if (!_expandedOptionSections.Add(section))
            _expandedOptionSections.Remove(section);
    }

    private string GetOptionSectionChevron(string section) =>
        IsOptionSectionExpanded(section) ? "bi-chevron-up" : "bi-chevron-down";

    private async Task ToggleLogLevel(string level, bool isChecked)
    {
        LogFilters.ToggleLevel(State, level, isChecked);
        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private async Task ToggleThread(string thread, bool isChecked)
    {
        LogFilters.ToggleThread(State, thread, isChecked);
        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private async Task SelectAllThreads()
    {
        LogFilters.SelectAllThreads(State);
        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private async Task DeselectAllThreads()
    {
        LogFilters.DeselectAllThreads(State);
        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private async Task OnTimeLimitChanged(int minutes)
    {
        State.LogHistoryMinutes = minutes;
        await ReloadLogsForHistoryChangeAsync();
    }

    private async Task OnLineLimitChanged(int lines)
    {
        State.LogLineLimit = lines;
        await ReloadLogsForHistoryChangeAsync();
    }

    private async Task ReloadLogsForHistoryChangeAsync()
    {
        LogRetention.NormalizeLimits(State);
        await LogSession.LoadRecentLogsAsync(Server, State);
        _pendingInitialScroll = true;
        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private async Task ToggleLogs()
    {
        State.ShowLogs = !State.ShowLogs;
        if (State.ShowLogs)
        {
            await LogSession.LoadRecentLogsAsync(Server, State);
            _pendingInitialScroll = true;
        }

        StartLogPolling();
        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private async Task ToggleCommands()
    {
        State.ShowCommands = !State.ShowCommands;
        await OnPersistRequested.InvokeAsync();
        StateHasChanged();
    }

    private void OnCommandTypeChanged(ChangeEventArgs e)
    {
        State.SelectedCommandId = e.Value?.ToString() ?? DefaultSayCommandId ?? string.Empty;
        State.CommandArguments = string.Empty;
    }

    private void OnCommandArgumentsChanged(ChangeEventArgs e) =>
        State.CommandArguments = e.Value?.ToString() ?? string.Empty;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendCommand();
            return;
        }

        if (e.Key == "ArrowUp" && State.CommandHistoryOnly.Count > 0 && State.HistoryIndex > 0)
        {
            State.HistoryIndex--;
            MinecraftCommandSyntax.ApplyHistoryCommand(
                State, Commands, DefaultSayCommandId, State.CommandHistoryOnly[State.HistoryIndex]);
            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (State.CommandHistoryOnly.Count > 0 && State.HistoryIndex < State.CommandHistoryOnly.Count - 1)
            {
                State.HistoryIndex++;
                MinecraftCommandSyntax.ApplyHistoryCommand(
                    State, Commands, DefaultSayCommandId, State.CommandHistoryOnly[State.HistoryIndex]);
            }
            else
            {
                State.HistoryIndex = State.CommandHistoryOnly.Count;
                State.CommandArguments = string.Empty;
            }
        }
    }

    private async Task SendCommand()
    {
        var selectedCmd = MinecraftCommandSyntax.GetSelectedCommand(State, Commands, DefaultSayCommandId);
        if (!MinecraftCommandSyntax.CanSend(State, selectedCmd))
            return;

        var originalCmd = MinecraftCommandSyntax.BuildCommand(State, selectedCmd);
        var currentUser = await AuthService.GetCurrentUserAsync();
        var username = currentUser?.Username?.ToUpperInvariant() ?? "RCON";
        var cmdToSend = ConsoleCommandFormatter.InjectUsername(originalCmd, username);

        await PrepareAutoscrollCheckAsync();

        try
        {
            var response = await Rcon.SendCommandAsync(Server, cmdToSend);
            State.OnlineStatus = ServerOnlineStatus.Online;
            State.LastStatusCheckUtc = DateTime.UtcNow;
            await RecordCommandAsync(new CommandHistoryItem
            {
                Timestamp = DateTime.UtcNow,
                Command = originalCmd,
                Response = ConsoleCommandFormatter.FormatResponse(response),
                ExecutedBy = currentUser?.Username
            });
        }
        catch (Exception ex)
        {
            State.OnlineStatus = ClassifyCommandFailure(ex);
            State.LastStatusCheckUtc = DateTime.UtcNow;
            await RecordCommandAsync(new CommandHistoryItem
            {
                Timestamp = DateTime.UtcNow,
                Command = originalCmd,
                Response = $"[ERROR] {ex.Message}",
                ExecutedBy = currentUser?.Username
            });
        }

        State.CommandArguments = string.Empty;
        StateHasChanged();
        await AfterContentUpdateAsync(contentAdded: true, legacyOffScroll: true);

        if (State.ShowLogs)
            _ = RefreshLogsAfterCommandAsync();
    }

    private async Task RecordCommandAsync(CommandHistoryItem item)
    {
        await ConsoleActivity.AppendAsync(State.ServerId, item);
        State.CommandHistoryOnly.Add(item.Command);
        State.HistoryIndex = State.CommandHistoryOnly.Count;
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", OutputElementId);
        }
        catch
        {
        }
    }

    private async Task<bool> IsAtBottomAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("isConsoleAtBottom", OutputElementId);
        }
        catch
        {
            return true;
        }
    }

    private async Task PrepareAutoscrollCheckAsync()
    {
        if (State.AutoscrollMode == ConsoleAutoscrollMode.Auto)
            _stickToBottomForAuto = await IsAtBottomAsync();
    }

    private async Task AfterContentUpdateAsync(bool contentAdded, bool legacyOffScroll)
    {
        var shouldScroll = State.AutoscrollMode switch
        {
            ConsoleAutoscrollMode.On => contentAdded,
            ConsoleAutoscrollMode.Auto => contentAdded && _stickToBottomForAuto,
            _ => legacyOffScroll,
        };

        if (!shouldScroll)
            return;

        await Task.Delay(50);
        await ScrollToBottom();
    }

    private async Task CheckServerStatusAsync(bool initial)
    {
        if (Interlocked.CompareExchange(ref _statusCheckRunning, 1, 0) != 0)
            return;

        try
        {
            var previous = State.OnlineStatus;

            if (initial && previous == ServerOnlineStatus.Unknown)
            {
                State.OnlineStatus = ServerOnlineStatus.Checking;
                await InvokeAsync(StateHasChanged);
            }

            ServerOnlineStatus next;
            try
            {
                if (initial)
                {
                    next = await Rcon.EnsureConnectedAsync(Server);
                }
                else
                {
                    next = await Rcon.CheckReachabilityAsync(Server);
                    if (next != ServerOnlineStatus.Online
                        && DateTime.UtcNow - _lastReconnectAttemptUtc >= ReconnectBackoff)
                    {
                        _lastReconnectAttemptUtc = DateTime.UtcNow;
                        next = await Rcon.EnsureConnectedAsync(Server);
                    }
                }
            }
            catch
            {
                next = ServerOnlineStatus.Offline;
            }

            State.LastStatusCheckUtc = DateTime.UtcNow;

            if (next != previous || previous == ServerOnlineStatus.Checking)
            {
                State.OnlineStatus = next;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            Interlocked.Exchange(ref _statusCheckRunning, 0);
        }
    }

    private static ServerOnlineStatus ClassifyCommandFailure(Exception ex)
    {
        var message = ex.Message;
        if (message.Contains("authentication", StringComparison.OrdinalIgnoreCase)
            || message.Contains("password", StringComparison.OrdinalIgnoreCase))
        {
            return ServerOnlineStatus.AuthError;
        }

        if (message.Contains("Failed to connect", StringComparison.OrdinalIgnoreCase)
            || message.Contains("Could not resolve hostname", StringComparison.OrdinalIgnoreCase))
        {
            return ServerOnlineStatus.Offline;
        }

        return ServerOnlineStatus.Offline;
    }

    private string GetStatusPillClass() => State.OnlineStatus switch
    {
        ServerOnlineStatus.Online => "status-online",
        ServerOnlineStatus.Offline => "status-offline",
        ServerOnlineStatus.AuthError => "status-auth-error",
        ServerOnlineStatus.Checking => "status-checking",
        _ => "status-unknown",
    };

    private string GetStatusLabel() => State.OnlineStatus switch
    {
        ServerOnlineStatus.Online => "Online",
        ServerOnlineStatus.Offline => "Offline",
        ServerOnlineStatus.AuthError => "Auth",
        ServerOnlineStatus.Checking => "…",
        _ => "—",
    };

    private string GetStatusTooltip() => State.OnlineStatus switch
    {
        ServerOnlineStatus.Online => "RCON connected",
        ServerOnlineStatus.Offline => "RCON unreachable — server may be down or host/port wrong",
        ServerOnlineStatus.AuthError => "RCON reachable but authentication failed — check password",
        ServerOnlineStatus.Checking => "Checking RCON connection…",
        _ => "Server status unknown",
    };
